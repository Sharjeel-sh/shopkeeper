{
  "functions": {
    "source": "functions",
    "predeploy": ["bash -c \"rm -rf functions/backend && cp -r backend/src functions/backend\""]
  },
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
